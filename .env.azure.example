# Referencia. deploy-azure.ps1 configura estas variables como secretos en Container Apps.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3018
WEB_ORIGIN=https://NOMBRE_APP.DOMINIO_CONTAINER_APPS
SERVE_WEB=true
WEB_ROOT=/app/dist/web
TRUST_PROXY=1
STORAGE_ROOT=/data/storage
PYTHON_PATH=/opt/venv/bin/python
POSE_MODEL_PATH=/opt/models/pose_landmarker.task
BLENDER_PATH=/usr/bin/blender
RUN_DB_SEED=true
DATABASE_URL=postgresql://USUARIO:CONTRASENA@SERVIDOR.postgres.database.azure.com:5432/vestidor18?sslmode=require
JWT_SECRET=GENERAR_MINIMO_48_CARACTERES
