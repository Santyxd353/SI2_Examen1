generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anomalia {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ejecucion_id        String              @db.Uuid
  indicador           String              @db.VarChar(80)
  entidad_tipo        String              @db.VarChar(50)
  entidad_id          String?             @db.Uuid
  puntaje             Decimal             @db.Decimal(12, 4)
  evidencia           Json
  estado              String              @db.VarChar(20)
  revisado_por        String?             @db.Uuid
  observacion         String?             @db.VarChar(500)
  ejecucion_analitica ejecucion_analitica @relation(fields: [ejecucion_id], references: [id], onUpdate: NoAction, map: "fk_anomalia_ejecucion_id")
  usuario             usuario?            @relation(fields: [revisado_por], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_anomalia_revisado_por")

  @@index([ejecucion_id], map: "ix_anomalia_ejecucion_id")
  @@index([revisado_por], map: "ix_anomalia_revisado_por")
}

model auditoria {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  accion      String   @db.VarChar(100)
  entidad     String   @db.VarChar(60)
  entidad_id  String?  @db.Uuid
  cambios     Json
  motivo      String?  @db.VarChar(400)
  correlacion String   @db.Uuid
  creado_en   DateTime @db.Timestamptz(6)
  usuario     usuario? @relation(fields: [actor_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_auditoria_actor_id")

  @@index([actor_id], map: "ix_auditoria_actor_id")
}

