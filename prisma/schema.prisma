  devolucion_devolucion_revisado_porTousuario devolucion[]          @relation("devolucion_revisado_porTousuario")
  devolucion_devolucion_usuario_idTousuario   devolucion[]          @relation("devolucion_usuario_idTousuario")
  direccion                                   direccion[]
  dispositivo                                 dispositivo[]
  ejecucion_analitica                         ejecucion_analitica[]
  historial_pedido                            historial_pedido[]
  modelo_prenda                               modelo_prenda[]
  movimiento_stock                            movimiento_stock[]
  notificacion                                notificacion[]
  pedido_pedido_usuario_idTousuario           pedido[]              @relation("pedido_usuario_idTousuario")
  pedido_pedido_vendedor_idTousuario          pedido[]              @relation("pedido_vendedor_idTousuario")
  recomendacion                               recomendacion[]
  sesion                                      sesion[]
  sesion_vestidor                             sesion_vestidor[]
  trabajo_avatar                              trabajo_avatar[]
  usuario_rol                                 usuario_rol[]
  usuario_ubicacion                           usuario_ubicacion[]
}

model usuario_rol {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String   @db.Uuid
  rol_id      String   @db.Uuid
  asignado_en DateTime @db.Timestamptz(6)
  rol         rol      @relation(fields: [rol_id], references: [id], onUpdate: NoAction, map: "fk_usuario_rol_rol_id")
  usuario     usuario  @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_usuario_rol_usuario_id")

  @@unique([usuario_id, rol_id])
  @@index([rol_id], map: "ix_usuario_rol_rol_id")
  @@index([usuario_id], map: "ix_usuario_rol_usuario_id")
}

model usuario_ubicacion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id   String    @db.Uuid
  ubicacion_id String    @db.Uuid
  ubicacion    ubicacion @relation(fields: [ubicacion_id], references: [id], onUpdate: NoAction, map: "fk_usuario_ubicacion_ubicacion_id")
  usuario      usuario   @relation(fields: [usuario_id], references: [id], onUpdate: NoAction, map: "fk_usuario_ubicacion_usuario_id")

  @@unique([usuario_id, ubicacion_id])
  @@index([ubicacion_id], map: "ix_usuario_ubicacion_ubicacion_id")
  @@index([usuario_id], map: "ix_usuario_ubicacion_usuario_id")
}

model variante {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id          String                 @db.Uuid
  sku                  String                 @unique @db.VarChar(60)
  codigo_barras        String?                @unique @db.VarChar(80)
  talla                String                 @db.VarChar(20)
  color                String                 @db.VarChar(50)
  color_hex            String?                @db.VarChar(7)
  activa               Boolean
  detalle_pedido       detalle_pedido[]
  disponibilidad_canal disponibilidad_canal[]
  evento_vestidor      evento_vestidor[]
  inventario           inventario[]
  item_carrito         item_carrito[]
  modelo_prenda        modelo_prenda[]
  precio_canal         precio_canal[]
  prediccion           prediccion[]
  recomendacion        recomendacion[]
  recurso_catalogo     recurso_catalogo[]
  producto             producto               @relation(fields: [producto_id], references: [id], onUpdate: NoAction, map: "fk_variante_producto_id")

  @@unique([producto_id, talla, color])
  @@index([producto_id], map: "ix_variante_producto_id")
}
