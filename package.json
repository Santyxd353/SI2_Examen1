{
  "name": "vestidor-grupo18",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:check": "npm --prefix apps/mobile run check",
    "mobile:pose-test": "tsx --test apps/mobile/test/pose.test.ts",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:prepare-test": "tsx scripts/prepare-test.ts",
    "user:grant-admin": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/websockets": "^11.2.5",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "multer": "2.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.183.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "supertest": "^7.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "multer": "$multer",
    "deepmerge-ts": "8.0.0"
  }
}
